generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum LoanStatus {
  ENTERED
  DOCUMENTS_PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FinanceServiceCategory {
  DSA
  DSA_PRODUCT
  SERVICE
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  passwordHash  String
  role          UserRole         @default(STAFF)
  isActive      Boolean          @default(true)
  assignedLoans Loan[]           @relation("LoanAssignee")
  followUps     LoanFollowUp[]   @relation("FollowUpCreator")
  enquiries     FinanceEnquiry[] @relation("EnquiryAssignee")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([role, isActive])
}

model Customer {
  id              String           @id
  customerId      String           @unique
  name            String
  mobile          String
  alternateMobile String?
  email           String?
  address         String?
  city            String?
  occupation      String?
  pan             String?
  aadhaarLast4    String?
  notes           String?
  loans           Loan[]
  carsSoldToUs    Car[]            @relation("CarSeller")
  carsBought      CarSale[]        @relation("CarBuyer")
  financeEnquiries FinanceEnquiry[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([mobile])
  @@index([name])
  @@index([createdAt])
}

model Car {
  id                 String      @id
  vehicleId          String      @unique
  sellerId           String
  seller             Customer    @relation("CarSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  registrationNumber String
  make               String
  model              String
  year               Int?
  ownerNumber        Int?
  km                 Int?
  fuel               String?
  purchasePrice      Float
  status             CarStatus   @default(AVAILABLE)
  purchaseDate       DateTime    @default(now())
  notes              String?
  documents          Json        @default("{ \"carBook\": false, \"carInsurance\": false, \"agreement\": false, \"customDocuments\": [] }")
  expenses           CarExpense[]
  sale               CarSale?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([sellerId])
  @@index([registrationNumber])
  @@index([status])
  @@index([createdAt])
}

model CarExpense {
  id          String   @id
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([carId, date])
}

model CarSale {
  id              String   @id
  saleId          String   @unique
  carId           String   @unique
  car             Car      @relation(fields: [carId], references: [id], onDelete: Restrict)
  buyerId         String
  buyer           Customer @relation("CarBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellingPrice    Float
  sellingExpenses Float    @default(0)
  totalInvestment Float
  profit          Float
  saleDate        DateTime @default(now())
  notes           String?
  documents       Json     @default("{ \"idProof\": false, \"agreement\": false, \"customDocuments\": [] }")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([buyerId])
  @@index([saleDate])
}

model Loan {
  id                       String         @id
  loanId                   String         @unique
  customerId               String
  customer                 Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanType                 String
  requiredAmount           Float
  approvedAmount           Float?
  financeCompany           String?
  status                   LoanStatus     @default(ENTERED)
  applicationDate          DateTime       @default(now())
  expectedDisbursementDate DateTime?
  disbursementDate         DateTime?
  commission               Float          @default(0)
  rejectionReason          String?
  notes                    String?
  assignedToId             String?
  assignedTo               User?          @relation("LoanAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  documents                Json           @default("{ \"idProof\": false, \"addressProof\": false, \"incomeProof\": false, \"bankStatement\": false, \"customDocuments\": [] }")
  followUps                LoanFollowUp[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@index([financeCompany])
}

model LoanFollowUp {
  id               String         @id
  loanId           String
  loan             Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  followUpDate     DateTime
  nextFollowUpDate DateTime?
  note             String
  status           FollowUpStatus  @default(OPEN)
  createdById      String?
  createdBy        User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([loanId, followUpDate])
  @@index([status, followUpDate])
}

model FinanceService {
  id          String                 @id
  code        String                 @unique
  name        String
  category    FinanceServiceCategory
  parentCode  String?
  description String?
  active      Boolean                @default(true)
  sortOrder   Int                    @default(0)
  enquiries   FinanceEnquiry[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([active, sortOrder])
  @@index([parentCode])
}

model FinanceEnquiry {
  id             String         @id
  enquiryId      String         @unique
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceCode    String
  service        FinanceService @relation(fields: [serviceCode], references: [code], onDelete: Restrict)
  financeCompany String?
  requiredAmount Float?
  status         EnquiryStatus  @default(NEW)
  followUpDate   DateTime?
  notes          String?
  assignedToId   String?
  assignedTo     User?          @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([customerId])
  @@index([serviceCode])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model FinanceCompany {
  id        String   @id
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String   @id
  sourceType   String
  recordId     String
  ownerType    String?
  ownerId      String?
  name         String
  originalName String
  fileType     String?
  fileSize     Int?
  fileUrl      String
  storageKey   String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceType, recordId])
  @@index([ownerType, ownerId])
  @@index([uploadedAt])
}